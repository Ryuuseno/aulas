<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ufg.aulas.controladores.LoginController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <children>
        <Label text="Gestión de Aulas" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
        <TextField fx:id="txtCorreo" promptText="Correo electrónico" />
        <PasswordField fx:id="txtClave" promptText="Contraseña" />
        <Button onAction="#ingresar" text="Ingresar" defaultButton="true" />
        <Label fx:id="lblMensaje" textFill="RED" />
    </children>
</VBox>
